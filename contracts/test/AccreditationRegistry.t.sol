pragma solidity ^0.8.24;
import {Test} from "forge-std/Test.sol";
import {AccreditationRegistry} from "../src/AccreditationRegistry.sol";
contract AccreditationRegistryTest is Test { AccreditationRegistry registry; address issuer = address(0x123); string did = "did:web:uni.example"; function setUp() public { registry = new AccreditationRegistry(address(this)); } function testRegistration() public { registry.registerIssuer(did, issuer, uint64(block.timestamp), uint64(block.timestamp + 1 days), "ipfs://metadata"); assertTrue(registry.isAccredited(did)); } function testUnauthorizedRegistrationReverts() public { vm.prank(address(0xBEEF)); vm.expectRevert(); registry.registerIssuer(did, issuer, 1, 2, "x"); } function testRevocation() public { registry.registerIssuer(did, issuer, uint64(block.timestamp), uint64(block.timestamp + 1 days), "x"); registry.revokeIssuer(did); assertFalse(registry.isAccredited(did)); } function testExpiry() public { registry.registerIssuer(did, issuer, uint64(block.timestamp - 2 days), uint64(block.timestamp - 1 days), "x"); assertFalse(registry.isAccredited(did)); } function testAuthorizedUpdate() public { registry.registerIssuer(did, issuer, uint64(block.timestamp), uint64(block.timestamp + 1 days), "x"); registry.updateIssuer(did, address(0x456), uint64(block.timestamp + 2 days), "y"); assertTrue(registry.isAccredited(did)); } }
